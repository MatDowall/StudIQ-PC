{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StudIQ",
  "version": "0.1.10",
  "identifier": "com.takeitoff.app",
  "build": {
    "frontendDist": "src-frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "dotnet build ../../excel-com-addin -c Release && npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "StudIQ",
        "width": 1400,
        "height": 900,
        "maximized": true,
        "resizable": true,
        "dragDropEnabled": false,
        "visible": false,
        "decorations": false
      },
      {
        "label": "splashscreen",
        "url": "splashscreen.html",
        "width": 360,
        "height": 280,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "center": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPLOCALDATA/tiles/**",
          "$APPCACHE/tiles/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": {
      "../libs/pdfium/*": "libs/pdfium/",
      "../target/release/pdf_renderer.exe": "pdf_renderer.exe",
      "../excel-addin/dist/*": "excel-addin/dist/",
      "../excel-addin/dist/assets/*": "excel-addin/dist/assets/",
      "../excel-com-addin/bin/Release/net48/publish/StudIQ64-packed.xll": "StudIQ64-packed.xll",
      "../excel-com-addin/bin/Release/net48/publish/Microsoft.Web.WebView2.Core.dll": "Microsoft.Web.WebView2.Core.dll",
      "../excel-com-addin/bin/Release/net48/publish/Microsoft.Web.WebView2.WinForms.dll": "Microsoft.Web.WebView2.WinForms.dll",
      "../excel-com-addin/bin/Release/net48/publish/WebView2Loader.dll": "WebView2Loader.dll",
      "../excel-com-addin/bin/Release/net48/publish/Newtonsoft.Json.dll": "Newtonsoft.Json.dll"
    },
    "windows": {
      "nsis": {
        "installerHooks": "./nsis-hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["tcop"],
        "name": "StudIQ Project",
        "description": "StudIQ Project File"
      },
      {
        "ext": ["tcopkg"],
        "name": "StudIQ Package",
        "description": "StudIQ Portable Project Package"
      },
      {
        "ext": ["sqtemplate"],
        "name": "StudIQ Template",
        "description": "StudIQ Workbook Template"
      }
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/MatDowall/StudIQ-PC/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVDNjBGRTEyQzUxMEM0NEIKUldSTHhCREZFdjVnWEg0ekV3RkNET1VUT2RsLzQrbUVwSGI3cnlHdDN3WjJneW0xZHhWTk1MNjYK"
    }
  }
}
