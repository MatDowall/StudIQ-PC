{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StudIQ",
  "version": "0.1.0",
  "identifier": "com.takeitoff.app",
  "build": {
    "frontendDist": "src-frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "StudIQ",
        "width": 1400,
        "height": 900,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPLOCALDATA/tiles/**",
          "$APPCACHE/tiles/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../libs/pdfium/*": "libs/pdfium/",
      "../target/release/pdf_renderer.exe": "pdf_renderer.exe"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
