<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>StudIQ.ExcelAddin</AssemblyName>
    <RootNamespace>StudIQ.ExcelAddin</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ExcelAddInName>StudIQ</ExcelAddInName>
    <ExcelAddInFileName>StudIQ</ExcelAddInFileName>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ExcelDna.AddIn" Version="1.8.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2535.41" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\desktop\icons\icon.png">
      <LogicalName>StudIQ.ExcelAddin.icon.png</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Copy WebView2 managed + native DLLs next to the packed XLL so ExcelDNA can resolve them -->
  <Target Name="CopyDepsToPublish" AfterTargets="ExcelDnaBuild">
    <ItemGroup>
      <_WebView2Managed Include="$(OutputPath)Microsoft.Web.WebView2.Core.dll;$(OutputPath)Microsoft.Web.WebView2.WinForms.dll" />
      <_WebView2Native Include="$(OutputPath)runtimes\win-x64\native\WebView2Loader.dll" />
      <_NewtonsoftJson Include="$(OutputPath)Newtonsoft.Json.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_WebView2Managed);@(_WebView2Native);@(_NewtonsoftJson)"
          DestinationFolder="$(OutputPath)publish\"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
