# Rust / Cargo build output (14GB+ — never commit)
/target/
**/target/

# Node / frontend build output
node_modules/
desktop/src-frontend/dist/
desktop/src-frontend/node_modules/

# PDFium binary — developer-placed per setup instructions, platform-specific, ~29MB
libs/pdfium/*
!libs/pdfium/.gitkeep

# Generated Tauri icons can be regenerated; keep source icon only
# (commented out — keep icons committed unless they bloat the repo)
# desktop/icons/

# SQLite project files and registries (user data, not source)
*.tcop
*.tcop-shm
*.tcop-wal
registry.db
*.db-shm
*.db-wal

# Dev/run logs and scratch artifacts
*.log
test_stdin.txt
test_stdout.txt
test_vectors.txt
test_milestone1.pdf

# Milestone verification screenshots (regenerable proof artifacts)
milestone2_tile.png
milestone3_window.png
milestone4_window.png

# Claude Code local (machine-specific) settings — keep shared settings.json tracked
.claude/settings.local.json

# Vite dependency pre-bundle cache
.vite/

# Excel Office JS add-in build output
excel-addin/dist/
excel-addin/node_modules/
excel-addin/deps_temp_*/

# Excel COM add-in .NET build output
excel-com-addin/bin/
excel-com-addin/obj/

# OS / editor cruft
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
